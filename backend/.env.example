# ─── Core ───────────────────────────────────────────────────────────────────
GRAPHMIND_DATA_DIR=./data
GRAPHMIND_CORS_ORIGINS=http://localhost:5173,https://lazee01.github.io
GRAPHMIND_REQUIRE_AUTH=false

# ─── Model Provider ─────────────────────────────────────────────────────────
# Options: local | sentence-transformers | huggingface | openai-compatible | groq
GRAPHMIND_MODEL_PROVIDER=local

GRAPHMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GRAPHMIND_GENERATION_MODEL=google/flan-t5-base
GRAPHMIND_NER_MODEL=dslim/bert-base-NER

# ─── OpenAI-Compatible / Groq API ────────────────────────────────────────────
GRAPHMIND_LLM_API_URL=
GRAPHMIND_LLM_API_KEY=
GRAPHMIND_GROQ_API_KEY=
GRAPHMIND_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ─── Neo4j (optional) ────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=graphmind

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Set GRAPHMIND_REQUIRE_AUTH=true behind HTTPS to protect routes
# Token expiry in hours
GRAPHMIND_TOKEN_EXPIRY_HOURS=24
